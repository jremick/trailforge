# TrailForge environment configuration (copy to .env for local overrides)

# PostgreSQL / PostGIS
# Note: Official postgis/postgis:16-3.4 is amd64-only. imresamu/postgis:16-3.4 is the
# PostGIS maintainer's multi-arch (linux/arm64 + linux/amd64) build.
POSTGIS_IMAGE=imresamu/postgis:16-3.4
POSTGRES_DB=trailforge
POSTGRES_USER=trailforge
POSTGRES_PASSWORD=trailforge
POSTGRES_PORT=5432

# Application database connection
DATABASE_URL=postgresql+psycopg://trailforge:trailforge@db:5432/trailforge

# API & Web ports
API_PORT=8000
WEB_PORT=5173
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Worker & Privacy Guardrails
WORKER_POLL_SECONDS=30
PRIVACY_TRIM_METERS=250
SNOW_LINE_DEFAULT_M=1000

# GDAL memory guardrails (16 GB laptop / homelab friendly)
GDAL_CACHEMAX=192
OMP_THREAD_LIMIT=1
