# TrailForge environment configuration (copy to .env for local overrides)

# PostgreSQL / PostGIS
# Note: Official postgis/postgis:16-3.4 is amd64-only. imresamu/postgis:16-3.4 is the
# PostGIS maintainer's multi-arch (linux/arm64 + linux/amd64) build.
POSTGIS_IMAGE=imresamu/postgis:16-3.4
POSTGRES_DB=trailforge
POSTGRES_USER=trailforge
POSTGRES_PASSWORD=trailforge
POSTGRES_PORT=5432

# Application database connection
DATABASE_URL=postgresql+psycopg://trailforge:trailforge@db:5432/trailforge

# API & Web ports
API_PORT=8000
WEB_PORT=5173
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Worker & Privacy Guardrails
WORKER_POLL_SECONDS=30
PRIVACY_TRIM_METERS=250
SNOW_LINE_DEFAULT_M=1000

# Self-Hosting Auth & Privacy Secrets
# CHANGE IN PRODUCTION! Generate strong random values with: openssl rand -hex 32
AUTH_SECRET_KEY=trailforge-dev-secret-change-in-production
TRAILFORGE_PRIVACY_SECRET=trailforge-dev-privacy-secret-change-in-production
# Set to true when serving TrailForge behind an HTTPS/TLS reverse proxy
AUTH_COOKIE_SECURE=false

# Live Upstream Agency & Rainfall Feeds (offline-safe false by default)
# Set to true to enable periodic background sync of VIC/NSW closures & Open-Meteo 72h rainfall
TRAILFORGE_ENABLE_LIVE_FEEDS=false
# Comma-separated AU states ('VIC,NSW' default; set 'VIC,NSW,ACT' or 'ALL' for pan-Australia)
TRAILFORGE_ENABLED_STATES=VIC,NSW

# Public Instance Access Control & Demo Banner (v1.1.0 Public Hardening)
# Local dev default is 'open'. Set 'invite_only' (or 'closed') on public internet instances!
TRAILFORGE_REGISTRATION_MODE=open
# Optional email that auto-bootstraps as the first 'admin' account on initial registration
TRAILFORGE_ADMIN_EMAIL=
# Optional slim dismissible info banner shown to visitors below the topbar
TRAILFORGE_DEMO_BANNER=

# Zero-Redis Edge Rate Limiting, Proxy Headers, Origin Lock-Down & Upload Disk Quota
TRAILFORGE_TRUST_PROXY_HEADERS=true
# Optional shared secret expected in X-TrailForge-Origin-Secret from Cloudflare Pages proxy.
# Leave blank for local dev; set a strong random value (openssl rand -hex 32) on public origins.
TRAILFORGE_ORIGIN_SHARED_SECRET=
# Optional OpenAPI docs toggle (/docs, /redoc, /openapi.json).
# Leave blank for auto: enabled in local dev, disabled in production mode.
TRAILFORGE_ENABLE_DOCS=
TRAILFORGE_RATE_LIMIT_ENABLED=true
TRAILFORGE_RATE_LIMIT_READ_PER_MIN=180
TRAILFORGE_RATE_LIMIT_AUTH_PER_MIN=12
TRAILFORGE_RATE_LIMIT_UPLOAD_PER_DAY=25
TRAILFORGE_UPLOADS_MAX_TOTAL_MB=500

# Optional Cloudflare R2 / Public CDN Offload for PMTiles & Offline Packs ($0 egress)
# Leave blank for local/homelab serving via /api/tiles and /api/packs.
# Example public values: https://tiles.example.com and https://packs.example.com
TILES_PUBLIC_BASE_URL=
PACKS_PUBLIC_BASE_URL=
# Credentials used only by `python -m trailforge.packs.r2_sync`:
TRAILFORGE_R2_ENDPOINT_URL=
TRAILFORGE_R2_BUCKET=
TRAILFORGE_R2_ACCESS_KEY_ID=
TRAILFORGE_R2_SECRET_ACCESS_KEY=

# GDAL memory guardrails (16 GB laptop / homelab friendly)
GDAL_CACHEMAX=192
OMP_THREAD_LIMIT=1

# AI & Model Context Protocol (MCP) Integration (v1.2)
# Master toggle for /mcp, /mcp/auth, and /.well-known/oauth-* discovery endpoints
TRAILFORGE_ENABLE_MCP=true
# Auth policy: 'hybrid' (public /mcp + OAuth /mcp/auth), 'oauth_required', or 'anonymous_only'
TRAILFORGE_MCP_AUTH_MODE=hybrid
# Canonical public HTTPS origin for deep links & OAuth 2.1 metadata (e.g. https://trails.example.com)
TRAILFORGE_PUBLIC_BASE_URL=
# Per-IP (or per-authenticated-user) sliding-window request cap on /mcp*
TRAILFORGE_RATE_LIMIT_MCP_PER_MIN=60
# Optional local file override for ui://trailforge/explorer.html hot reload during widget dev
TRAILFORGE_MCP_APP_HTML=
# Comma-separated bare origins allowed in MCP App _meta.ui.csp (auto-includes TILES_PUBLIC_BASE_URL origin)
TRAILFORGE_MCP_CSP_TILE_DOMAINS=
# Self-hosted OAuth 2.1 + PKCE + Dynamic Client Registration (RFC 7591) lifetimes & bounds
TRAILFORGE_OAUTH_ACCESS_TOKEN_TTL_S=3600
TRAILFORGE_OAUTH_REFRESH_TOKEN_TTL_S=2592000
TRAILFORGE_OAUTH_DCR_MAX_PER_IP_PER_DAY=20
