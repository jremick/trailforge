# TrailForge Automatic HTTPS Reverse Proxy Example (Caddy v2)
#
# Create and mount the private ingress socket directory using deploy/README.md.
# Copy to /etc/caddy/Caddyfile (or mount into a Caddy container sharing the
# socket directory) and replace `trails.example.com` with your domain.
#
# Required TrailForge `.env` settings behind HTTPS:
#   CORS_ORIGINS=https://trails.example.com
#   TRAILFORGE_PUBLIC_BASE_URL=https://trails.example.com
#   AUTH_COOKIE_SECURE=true
#   AUTH_SECRET_KEY=<64-hex-chars from: openssl rand -hex 32>
#   TRAILFORGE_PRIVACY_SECRET=<64-hex-chars from: openssl rand -hex 32>
#
# PMTiles Range / 206 Partial Content notes:
#   - Caddy passes client `Range`, `If-Range`, and `If-None-Match` headers
#     through untouched, and `flush_interval -1` streams 206 byte ranges and
#     offline pack `bundle.tar.gz` archives without proxy buffering.
#   - Compression (`encode`) is explicitly excluded from `/api/tiles/*` and
#     `/api/packs/*/tiles/*` so binary PMTiles byte ranges are never re-encoded.
#
# MCP Streamable HTTP & OAuth 2.1 notes:
#   - `/mcp` and `/mcp/*` are excluded from `@compressible` so Streamable HTTP
#     SSE frames flush immediately (`flush_interval -1`) without gzip/zstd buffering.
#   - Caddy forwards `Authorization`, `Accept`, `Content-Type`, `Mcp-Session-Id`,
#     `MCP-Protocol-Version`, and `Last-Event-ID` verbatim, sets `X-Forwarded-Host`
#     and `X-Forwarded-Proto` for `/.well-known/oauth-*` discovery metadata, and
#     preserves upstream `Mcp-Session-Id` and `WWW-Authenticate` response headers.

trails.example.com {
	# Outer ceiling. The web service applies smaller request limits by route.
	request_body {
		max_size 17MB
	}

	# Compress HTML/JS/CSS/JSON/SVG while keeping PMTiles Range endpoints,
	# pre-compressed offline pack archives, and MCP Streamable HTTP SSE streams
	# (`/mcp`, `/mcp/*`) unbuffered and uncompressed.
	@compressible {
		not path /api/tiles/* /api/packs/*/tiles/* /api/packs/*/bundle.tar.gz /mcp /mcp/*
	}
	encode @compressible zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# The private socket applies download limits per client. For the TCP fallback,
	# use 127.0.0.1:5173 on the host or web:8080 on the shared Docker network.
	# TCP fallback uses a shared Caddy-peer allowance.
	reverse_proxy unix//var/lib/trailforge-ingress/web.sock {
		flush_interval -1
		header_up -CF-Connecting-IP
		header_up Host {http.request.host}
		header_up X-Forwarded-Host {http.request.host}
		header_up X-Forwarded-Proto {http.request.scheme}
		# Client `Range`, `If-Range`, `If-None-Match`, `Authorization`, `Accept`,
		# `Mcp-Session-Id`, `MCP-Protocol-Version`, and `Last-Event-ID` headers
		# are forwarded verbatim by Caddy; upstream `Mcp-Session-Id` and
		# `WWW-Authenticate` headers are preserved unchanged.
		transport http {
			read_timeout 180s
			write_timeout 180s
		}
	}
}
