# TrailForge Railway Production Environment Template (v1.1.0 Public Instance)
#
# Copy these variables into your Railway `api` (and shared `worker`) service
# settings and replace every placeholder value before exposing your instance.
# Full walkthrough: deploy/railway/README.md

# ---------------------------------------------------------------------------
# 1. Build & Database (Railway Private Network = $0 internal egress)
# ---------------------------------------------------------------------------
# Skip pytest/ruff dev packages in the Railway production image build:
INSTALL_DEV=false

# IMPORTANT: TrailForge uses SQLAlchemy + psycopg3 (`postgresql+psycopg://`).
# Reference your Railway PostGIS service over private networking (*.railway.internal):
DATABASE_URL=postgresql+psycopg://${{PostGIS.POSTGRES_USER}}:${{PostGIS.POSTGRES_PASSWORD}}@${{PostGIS.RAILWAY_PRIVATE_DOMAIN}}:5432/${{PostGIS.POSTGRES_DB}}

# ---------------------------------------------------------------------------
# 2. Public Web Origin, Auth Secrets & Access Control
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
# Set to your Cloudflare Pages custom domain (comma-separated if multiple):
CORS_ORIGINS=https://trails.example.com

# REQUIRED: Generate strong 64-hex-char secrets with `openssl rand -hex 32`
AUTH_SECRET_KEY=<generate-64-hex-chars-with-openssl-rand-hex-32>
TRAILFORGE_PRIVACY_SECRET=<generate-64-hex-chars-with-openssl-rand-hex-32>

# REQUIRED behind Cloudflare Pages HTTPS proxy so session cookies stay TLS-only
AUTH_COOKIE_SECURE=true

# Public instance access mode:
#   open        - anyone can register (local dev / private Tailnet only)
#   invite_only - browsing & route planning are public; uploads require a friend invite code
#   closed      - browsing remains public; all new registrations are disabled
TRAILFORGE_REGISTRATION_MODE=invite_only

# First account registering with this email auto-bootstraps as `admin`
# (allowed even while TRAILFORGE_REGISTRATION_MODE=invite_only).
TRAILFORGE_ADMIN_EMAIL=admin@example.com

# Optional slim dismissible banner shown to public visitors below the topbar
TRAILFORGE_DEMO_BANNER=Public Australian 4WD Trail Intelligence preview — browsing and route planning are open to everyone; a friend invite code is required to upload trips or condition reports.
# Hide the sidebar Stack & Offline Telemetry section from signed-out visitors by default
# (always visible to signed-in members and admins; also configurable at runtime in Admin Console).
TRAILFORGE_SHOW_STACK_TELEMETRY_PUBLIC=false

# ---------------------------------------------------------------------------
# 3. Zero-Redis Edge Rate Limiting, Origin Lock-Down, Proxy Trust & Quotas
# ---------------------------------------------------------------------------
# Read real client IPs from CF-Connecting-IP / X-Forwarded-For behind Cloudflare
TRAILFORGE_TRUST_PROXY_HEADERS=true
# REQUIRED behind Cloudflare Pages proxy: set to the exact same 64-hex value as
# `ORIGIN_SHARED_SECRET` in Cloudflare Pages so direct *.up.railway.app requests
# (except /api/health and /healthz) are rejected with HTTP 403.
TRAILFORGE_ORIGIN_SHARED_SECRET=<generate-64-hex-chars-with-openssl-rand-hex-32>
# Keep interactive OpenAPI docs (/docs, /redoc, /openapi.json) disabled in production
TRAILFORGE_ENABLE_DOCS=false
TRAILFORGE_RATE_LIMIT_ENABLED=true
TRAILFORGE_RATE_LIMIT_READ_PER_MIN=180
TRAILFORGE_RATE_LIMIT_AUTH_PER_MIN=12
TRAILFORGE_RATE_LIMIT_UPLOAD_PER_DAY=25

# Hard total disk cap for /data/uploads (community report photos) to protect
# your Railway persistent volume from filling up (returns HTTP 507 when full).
TRAILFORGE_UPLOADS_MAX_TOTAL_MB=500

# ---------------------------------------------------------------------------
# 4. Cloudflare R2 Offload ($0 Egress for PMTiles & Offline Packs)
# ---------------------------------------------------------------------------
# Public custom domain attached to your Cloudflare R2 bucket (with CORS policy
# from deploy/cloudflare/r2-cors.json). Using the same bucket serves root
# vector/terrain PMTiles and `<region_id>/...` offline packs directly from R2:
TILES_PUBLIC_BASE_URL=https://tiles.example.com
PACKS_PUBLIC_BASE_URL=https://tiles.example.com
# Alternatively, point PACKS_PUBLIC_BASE_URL to a dedicated bucket domain:
# PACKS_PUBLIC_BASE_URL=https://packs.example.com

# Credentials used ONLY when running `python -m trailforge.packs.r2_sync`
TRAILFORGE_R2_ENDPOINT_URL=https://<cloudflare-account-id>.r2.cloudflarestorage.com
TRAILFORGE_R2_BUCKET=trailforge-tiles
TRAILFORGE_R2_ACCESS_KEY_ID=<r2-api-token-access-key-id>
TRAILFORGE_R2_SECRET_ACCESS_KEY=<r2-api-token-secret-access-key>

# ---------------------------------------------------------------------------
# 5. Live Agency Feeds, Worker Polling, Storage & GDAL Guardrails
# ---------------------------------------------------------------------------
TRAILFORGE_ENABLE_LIVE_FEEDS=true
# Comma-separated AU states ('VIC,NSW', 'VIC,NSW,ACT', or 'ALL' for pan-Australia)
TRAILFORGE_ENABLED_STATES=VIC,NSW

# Worker polling cadence (60s keeps Railway worker CPU/RAM ultra-lean)
WORKER_POLL_SECONDS=60
PRIVACY_TRIM_METERS=250
SNOW_LINE_DEFAULT_M=1000

# Persistent Railway volume paths (mount Railway volume at /data on `api`)
TRAILFORGE_DATA_DIR=/data
TILES_DIR=/data/tiles
PACKS_DIR=/data/packs
TRAILFORGE_PACKS_DIR=/data/packs
TRAILFORGE_UPLOADS_DIR=/data/uploads

# Memory-bounded GDAL defaults for lean cloud containers
GDAL_CACHEMAX=192
OMP_THREAD_LIMIT=1
